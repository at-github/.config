; Vertical bar on the right for i3, driven by scripts/i3-listener.py
; (start it with launch.sh: position and fullscreen hiding come from the script).

(defvar workspaces "[]")

(defwindow bar
  :geometry (geometry :width "40px" :height "100%")
  :anchor "top left"
  (centerbox :orientation "v"
    (workspaces)
    (box)
    (infos)))

(defpoll keyboard :initial `{"layout":"","caps":false}` :interval "1s" "scripts/keyboard.sh")
(deflisten network :initial `{"icon":"","speed":""}` "scripts/network.py")
(defpoll weather :initial `{"icon":"","temp":"","wind_icon":"","wind":""}` :interval "3600s" "scripts/weather.py")
(defpoll home_assistant :initial "[]" :interval "60s" "scripts/home-assistant.py")
(defpoll toggles :initial `{"redshift_icon":"","mic_icon":"","mic_in_use":false,"xscreensaver_icon":""}` :interval "1s" "scripts/toggles.sh")

(defwidget info [icon text]
  (box :class "info" :orientation "v" :space-evenly false
    (label :class "icon" :text icon)
    (label :text text)))

(defwidget ha-block [block]
  (box :orientation "v" :space-evenly false
    (box :class "${block.label != "" ? "info" : ""}" :orientation "v" :space-evenly false
      (label :class "block-label" :visible {block.label != ""} :text {block.label})
      (for line in {block.lines}
        (box :class "${line.icon != "" ? "info" : ""}" :orientation "v" :space-evenly false
          (label :class "icon" :visible {line.icon != ""} :text {line.icon})
          (label :class "${line.alert ? "alert" : ""}" :text {line.text}))))
    (box :class "separator")))

(defwidget toggles []
  (box :orientation "v" :space-evenly false
    (eventbox :onclick "~/.config/polybar/scripts/redshift.sh toggle"
      (label :class "icon toggle" :text {toggles.redshift_icon}))
    (label :class "icon toggle ${toggles.mic_in_use ? "mic-in-use" : ""}" :text {toggles.mic_icon})
    (eventbox :onclick "~/.config/polybar/scripts/toggle-xscreensaver.sh"
      (label :class "icon toggle" :text {toggles.xscreensaver_icon}))
    (box :class "separator")))

(defwidget infos []
  (box :class "infos"
       :orientation "v"
       :space-evenly false
       :valign "end"
    (toggles)
    (box :orientation "v" :space-evenly false
      (for block in home_assistant
        (box :visible {block.label != ""}
          (ha-block :block block))))
    (box :orientation "v" :space-evenly false
      (for block in home_assistant
        (box :visible {block.label == ""}
          (ha-block :block block))))
    (info :icon {weather.icon} :text {weather.temp})
    (box :visible {weather.wind != ""}
      (info :icon {weather.wind_icon} :text {weather.wind}))
    (box :class "separator")
    (info :icon "󰋊" :text "${round(EWW_DISK["/"].used_perc, 0)}%")
    (info :icon "󰍛" :text "${round(EWW_RAM.used_mem_perc, 0)}%")
    (info :icon "󰻠" :text "${round(EWW_CPU.avg, 0)}%")
    (label :class "caps" :visible {keyboard.caps} :text "󰌎")
    (info :icon "" :text {keyboard.layout})
    (info :icon {network.icon} :text {network.speed})))

(defwidget workspaces []
  (eventbox :onscroll "i3-msg workspace $([ {} = up ] && echo prev_on_output || echo next_on_output)"
    (box :class "workspaces"
         :orientation "v"
         :space-evenly false
         :valign "start"
      (for ws in workspaces
        (button :class "${ws.focused ? "focused" : ""} ${ws.urgent ? "urgent" : ""}"
                :onclick "i3-msg workspace number ${ws.num}"
          "${ws.icon}")))))
