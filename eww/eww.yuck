; Vertical bar on the right for i3, driven by scripts/i3-listener.py
; (start it with launch.sh: position and fullscreen hiding come from the script).

(deflisten workspaces :initial "[]" "scripts/workspaces.py")

(defwindow bar
  :geometry (geometry :width "60px" :height "100%")
  :anchor "top left"
  (centerbox :orientation "v"
    (box :orientation "v" :space-evenly false :valign "start"
      (clock)
      (weather-info)
      (workspaces))
    (box)
    (infos)))

; Opened by a click on the clock, just left of the bar (x offset = bar width)
(defwindow calendar
  :geometry (geometry :anchor "top right" :x "-60px" :y "0px")
  (box :class "calendar-window"
    (eventbox :cursor "hand2"
      (calendar :onclick "scripts/calendar.sh day {0} {1} {2}"))))

; Opened by a click on the power icon, just left of the bottom of the bar
(defwindow power
  :geometry (geometry :anchor "bottom right" :x "-60px" :y "0px")
  (box :class "power-window" :orientation "v" :space-evenly false
    (eventbox :cursor "hand2" (button :onclick "systemctl reboot" :tooltip "Redémarrer" "󰑓"))
    (eventbox :cursor "hand2" (button :onclick "systemctl poweroff" :tooltip "Éteindre" "󰤂"))))

(deflisten keyboard :initial `{"layout":"","caps":false}` "scripts/keyboard.py")
(deflisten network :initial `{"icon":"","speed":""}` "scripts/network.py")
(defpoll weather :initial `{"sky":{"icon":"","text":"","tooltip":"","alert":false},"probe":{"icon":"","text":"","tooltip":"","alert":false},"wind":{"icon":"","text":"","tooltip":"","alert":false}}` :interval "60s" "scripts/weather.py")
(defpoll home_assistant :initial "[]" :interval "60s" "scripts/home-assistant.py")
; `date` rather than formattime, to get the day name in the system locale
; Montréal: America/Toronto, the canonical zone (America/Montreal is a link to it)
(defpoll datetime :initial `{"hour":"","minute":"","day":"","date":"","full":"","mtl":"","mtl_full":""}` :interval "30s"
  `date +'{"hour":"%H","minute":"%M","day":"%a","date":"%d/%m","full":"%A %-d %B %Y",'; TZ=America/Toronto date +'"mtl":"%H:%M","mtl_full":"%A %-d %B, %H:%M"}'`)
(defpoll updates :initial "[]" :interval "3600s" "scripts/updates.sh")
(deflisten toggles :initial `{"redshift_active":false,"redshift_icon":"","mic_muted":false,"mic_icon":"","mic_in_use":false,"xscreensaver_active":false,"xscreensaver_icon":""}` "scripts/toggles.sh")

; Square cell (bar width), content centered; red (`alert`) when ?alert is true
(defwidget info [icon text tooltip ?alert]
  (box :class "cell ${alert == true ? "alert" : ""}" :tooltip tooltip
    (box :orientation "v" :space-evenly false :valign "center"
      (label :class "icon" :text icon)
      (label :text text))))

(defwidget ha-block [block]
  (box :orientation "v" :space-evenly false
    (box :orientation "v" :space-evenly false
      (label :class "block-label" :visible {block.label != ""} :text {block.label} :tooltip {block.name})
      ; Lines with a `toggle` entity (plugs) switch it on click. Detached:
      ; eww kills onclick commands after a fraction of a second
      (for line in {block.lines}
        (eventbox :class "${line.toggle != "" ? "clickable" : ""}"
                  :cursor "${line.toggle != "" ? "hand2" : "default"}"
                  :onclick "${line.toggle != "" ? "setsid -f scripts/ha-toggle.py ${line.toggle}" : ""}"
          (box :class "${line.icon != "" ? "cell" : ""} ${line.active ? "active" : ""}" :tooltip {line.tooltip}
            (box :orientation "v" :space-evenly false :valign "center"
              (label :class "icon" :visible {line.icon != ""} :text {line.icon})
              (label :class "${line.alert ? "alert" : ""}" :text {line.text}))))))
    (box :class "separator")))

(defwidget toggles []
  (box :orientation "v" :space-evenly false
    (eventbox :class "clickable" :onclick "scripts/toggles.sh redshift" :cursor "hand2"
              :tooltip {toggles.redshift_active ? "Redshift actif — clic pour le désactiver" : "Redshift désactivé — clic pour l'activer"}
      (label :class "icon cell" :text {toggles.redshift_icon}))
    (eventbox :class "clickable" :onclick "scripts/toggles.sh xscreensaver" :cursor "hand2"
              :tooltip {toggles.xscreensaver_active ? "Écran de veille actif — clic pour le désactiver" : "Écran de veille désactivé — clic pour l'activer"}
      (label :class "icon cell" :text {toggles.xscreensaver_icon}))
    (box :class "separator")))

(defwidget clock []
  (box :class "clock" :orientation "v" :space-evenly false
    (eventbox :class "clickable" :onclick "scripts/calendar.sh toggle" :cursor "hand2" :tooltip "${datetime.full} — clic : calendrier"
      (box :class "clock-content" :orientation "v" :space-evenly false
        (label :class "time" :text {datetime.hour})
        (label :class "time" :text {datetime.minute})
        (label :class "day" :text {datetime.day})
        (label :text {datetime.date})
        ; Montréal time, more discreet: maple leaf above
        (box :class "mtl" :orientation "v" :space-evenly false :tooltip "Montréal : ${datetime.mtl_full}"
          (label :text "")
          (label :text {datetime.mtl}))))
    (box :class "separator")))

; Between the clock and the workspaces, styled like the other infos:
; Météo-France forecast, outdoor probe, wind (red bug icon when unreadable)
(defwidget weather-info []
  (box :class "infos" :orientation "v" :space-evenly false
    (info :icon {weather.sky.icon} :text {weather.sky.text}
          :tooltip {weather.sky.tooltip} :alert {weather.sky.alert})
    (info :icon {weather.probe.icon} :text {weather.probe.text}
          :tooltip {weather.probe.tooltip} :alert {weather.probe.alert})
    (info :icon {weather.wind.icon} :text {weather.wind.text}
          :tooltip {weather.wind.tooltip} :alert {weather.wind.alert})
    (box :class "separator above-clickable")))

(defwidget infos []
  (box :class "infos"
       :orientation "v"
       :space-evenly false
       :valign "end"
    (toggles)
    (box :orientation "v" :space-evenly false
      (for block in home_assistant
        (ha-block :block block)))
    (label :class "icon cell ${toggles.mic_in_use ? "mic-in-use" : ""}" :text {toggles.mic_icon}
           :tooltip "${toggles.mic_muted ? "Micro coupé" : "Micro ouvert"}${toggles.mic_in_use ? " — utilisé par une application" : ""}")
    (info :icon "󰋊" :text "${round(EWW_DISK["/"].used_perc, 0)}%" :tooltip "Disque (/) utilisé")
    (info :icon "󰍛" :text "${round(EWW_RAM.used_mem_perc, 0)}%" :tooltip "Mémoire utilisée"
          :alert {EWW_RAM.used_mem_perc > 85})
    (info :icon "󰻠" :text "${round(EWW_CPU.avg, 0)}%" :tooltip "Processeur utilisé")
    (label :class "icon cell caps" :visible {keyboard.caps} :text "󰌎" :tooltip "Majuscules verrouillées")
    (info :icon "" :text {keyboard.layout} :tooltip "Disposition du clavier")
    (info :icon {network.icon} :text {network.speed}
          :tooltip {network.speed != "" ? "Débit descendant : ${network.speed}/s" : "Hors ligne"})
    (box :class "separator above-clickable")
    (box :class "updates" :orientation "v" :space-evenly false
      (for update in updates
        (eventbox :class "clickable" :onclick "scripts/updates.sh upgrade ${update.source}" :cursor "hand2"
          (info :icon {update.icon} :text {update.count}
                :tooltip {update.count == "!" ? "Mises à jour ${update.name} : la vérification a échoué" : "Mises à jour ${update.name} en attente — clic pour mettre à jour"}))))
    (box :class "separator above-clickable")
    (eventbox :class "clickable" :onclick "eww open --toggle power" :cursor "hand2" :tooltip "Menu d'arrêt"
      (label :class "icon cell" :text "󰐥"))))

(defwidget workspaces []
  (eventbox :onscroll "i3-msg workspace $([ {} = up ] && echo prev_on_output || echo next_on_output)"
    (box :class "workspaces"
         :orientation "v"
         :space-evenly false
         :valign "start"
      (for ws in workspaces
        (eventbox :cursor "hand2"
          (button :class "${ws.focused ? "focused" : ""} ${ws.urgent ? "urgent" : ""}"
                  :onclick "i3-msg workspace number ${ws.num}"
                  :tooltip "Workspace ${ws.num}"
            "${ws.icon}"))))))

; On-screen display for volume and media keys, centered on the screen.
; Driven by i3/scripts/osd.sh: it fills `osd` with `eww update`, opens the
; window and closes it once the keys have not been pressed for a while.
; `media` holds the current track, or nothing: a list rather than :visible,
; since eww sizes the window with hidden widgets too.
(defvar osd `{"media":[],"volume_glyph":"","level":0}`)

(defwindow osd
  :geometry (geometry :anchor "center" :width "1020px")
  :stacking "fg"
  :wm-ignore true
  :focusable false
  (box :class "osd" :orientation "v" :space-evenly false
    ; Current track (if any): status glyph, cover (if any), title (already
    ; wrapped), artist (if any)
    ; `for` appends its items at the end of its parent: own box, so they stay
    ; above the bar (empty, it takes no space)
    (box :orientation "v" :space-evenly false
      (for track in {osd.media}
        (box :class "osd-media" :space-evenly false
          (label :class "osd-glyph" :valign "start" :text {track.status_glyph})
          ; Same reason: the cover stays left of the title
          (box :space-evenly false :valign "start"
            (for cover in {track.covers}
              (image :class "osd-cover" :valign "start" :path cover
                     :image-width 120 :image-height 120)))
          (box :orientation "v" :space-evenly false
            (label :class "osd-title" :xalign 0 :text {track.title})
            ; Same reason: the artist stays under the title. Bottom of the
            ; column: lined up with the bottom of the cover (if any)
            (box :orientation "v" :space-evenly false :vexpand true :valign "end"
              (for artist in {track.artists}
                (label :class "osd-artist" :xalign 0 :text artist)))))))
    (box :space-evenly false
      (label :class "osd-glyph" :text {osd.volume_glyph})
      (progress :class "osd-bar" :hexpand true :valign "center" :value {osd.level}))))
